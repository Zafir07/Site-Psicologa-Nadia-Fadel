# ============================================================
# Configuração do servidor
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# CORS — domínio(s) autorizado(s) a consumir a API
# Em produção, use o domínio real do site (sem barra no final).
# Múltiplas origens podem ser separadas por vírgula.
# ============================================================
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500
# Exemplo em produção:
# FRONTEND_URL=https://psicologanadiafadel.com.br,https://www.psicologanadiafadel.com.br

# ============================================================
# Rate limiting
# ============================================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5

# ============================================================
# E-mail (Nodemailer) — para onde as mensagens do formulário serão enviadas
# Recomenda-se usar um serviço transacional (SMTP) e NÃO a senha normal
# de um e-mail pessoal. Para Gmail, use uma "Senha de app" com
# autenticação de dois fatores ativada.
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# E-mail que receberá as mensagens do formulário (pode ser igual ao SMTP_USER)
CONTACT_RECEIVER_EMAIL=contato@psicologanadiafadel.com.br

# E-mail que aparecerá como remetente das notificações
CONTACT_SENDER_NAME="Site Nádia Fadel"

# ============================================================
# Segurança adicional
# ============================================================
# Tamanho máximo (em bytes) aceito no corpo das requisições JSON
JSON_BODY_LIMIT=20kb
